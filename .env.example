# Ollama configuration for local LLM question generation
# In Docker Compose, this connects via internal network to the ollama container.
# For local runs outside Docker, set to http://localhost:11434.
OLLAMA_BASE_URL=http://ollama:11434
# Qwen model tag (e.g. qwen2.5:7b, qwen2.5:3b, qwen2.5:14b)
OLLAMA_MODEL=qwen2.5:7b
# Request timeout in seconds for question generation
OLLAMA_TIMEOUT_SECONDS=120
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=replace_with_a_long_random_secret
APP_ADMIN_PASSWORD=replace_with_a_strong_trainer_password
DATA_DIR=/app/data
MAX_UPLOAD_MB=15
MAX_SOURCE_CHARS=100000
ASSESSMENT_TOKEN_TTL_HOURS=168
SESSION_HTTPS_ONLY=false

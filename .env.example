# OpenAI API key from your OpenAI API project. Never commit a real key.
OPENAI_API_KEY=replace_with_your_api_key
# Verify this model is available to your API project before generating questions.
OPENAI_MODEL=gpt-6-luna
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=replace_with_a_long_random_secret
APP_ADMIN_PASSWORD=replace_with_a_strong_trainer_password
DATA_DIR=/app/data
MAX_UPLOAD_MB=15
MAX_SOURCE_CHARS=100000
ASSESSMENT_TOKEN_TTL_HOURS=168
SESSION_HTTPS_ONLY=false

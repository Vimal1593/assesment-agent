# LLM Provider selection: 'ollama' (default, local) or 'openai' (remote)
LLM_PROVIDER=ollama

# Ollama configuration for local question generation
# In Docker Compose, this connects via private network to the existing 'ollama' container.
# For local runs outside Docker, set to http://localhost:11434.
OLLAMA_BASE_URL=http://ollama:11434
# Qwen model tag (e.g. qwen2.5:0.5b-instruct, qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:0.5b-instruct
# Request timeout in seconds for question generation
OLLAMA_TIMEOUT_SECONDS=120
# Maximum output tokens to predict (ensures sufficient tokens for 10+ questions)
OLLAMA_NUM_PREDICT=2500
# Context window size in tokens
OLLAMA_NUM_CTX=4096

# Optional OpenAI fallback configuration (only used if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

APP_ENV=development
APP_HOST=0.0.0.0
# Container port (mapped to host port 8001 in compose.yaml for isolated testing)
APP_PORT=8000
APP_SECRET_KEY=replace_with_a_long_random_secret
APP_ADMIN_PASSWORD=replace_with_a_strong_trainer_password
DATA_DIR=/app/data
MAX_UPLOAD_MB=15
MAX_SOURCE_CHARS=100000
ASSESSMENT_TOKEN_TTL_HOURS=168
SESSION_HTTPS_ONLY=false
